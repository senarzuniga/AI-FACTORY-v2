{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionGraphEntry",
  "type": "object",
  "required": ["mission_id","title","status","created_at"],
  "properties": {
    "mission_id": {"type":"string"},
    "title": {"type":"string"},
    "objectives": {"type":"array","items":{"type":"string"}},
    "business_value": {"type":"number","minimum":0},
    "engineering_value": {"type":"number","minimum":0},
    "knowledge_required": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "risks": {"type":"array","items":{"type":"string"}},
    "architecture": {"type":"object"},
    "implementation_status": {"type":"string","enum":["planned","in_progress","blocked","completed"]},
    "evidence": {"type":"array","items":{"type":"object"}},
    "metrics": {"type":"object"},
    "global_engineering_score": {"type":"number"},
    "created_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"}
  }
}
