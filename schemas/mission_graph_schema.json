{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-factory.local/schemas/mission_graph_schema.json",
  "title": "MissionGraphEntry (Compatibility)",
  "deprecated": true,
  "description": "Compatibility schema. Canonical source is schemas/canonical_mission_model.schema.json",
  "type": "object",
  "required": ["mission_id", "title", "status", "created_at"],
  "properties": {
    "mission_id": {"type": "string"},
    "title": {"type": "string"},
    "objectives": {"type": "array", "items": {"type": "string"}},
    "business_value": {"type": "number", "minimum": 0},
    "engineering_value": {"type": "number", "minimum": 0},
    "knowledge_required": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "architecture": {"type": "object"},
    "implementation_status": {"type": "string", "enum": ["planned", "in_progress", "blocked", "completed"]},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "global_engineering_score": {"type": "number"},
    "canonical_ref": {"type": "string", "description": "Reference to canonical mission id"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
